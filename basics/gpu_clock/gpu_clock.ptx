.version 6.5
.target sm_61
.address_size 64

.file 1 "gpu_clock.ptx"

.visible .entry gpu_clock(
    .param .u64 a,
    .param .u64 b,
    .param .u64 c,
    .param .u32 n
) {
    /* --- Register Declarations --- */
    .reg .u32     %t1;
    .reg .u32     %t2;
    .reg .b64     %rd1;
    .reg .f32     %f1;
    .reg .f32     %f2;

    /* --- STEP 1: Capture start clock cycle --- *
     * Read the high-resolution hardware performance clock. */
    mov.u32       %t1, %clock;

    /* --- STEP 2: Load destination pointer 'c' --- *
     * Fetch the 64-bit base memory address for output storage. */
    ld.param.u64  %rd1, [c];

    /* --- STEP 3: Dummy work: capture end clock cycle --- *
     * Read the hardware clock again to measure execution interval. */
    mov.u32       %t2, %clock;

    /* --- STEP 4: Convert Integer Clocks to Float --- *
     * Convert 32-bit integer cycle counts to single-precision floating-point format. */
    cvt.rn.f32.u32 %f1, %t1;
    cvt.rn.f32.u32 %f2, %t2;

    /* --- STEP 5: Store results to memory --- *
     * Write start and end clock values sequentially into global VRAM. */
    st.global.f32 [%rd1], %f1;
    st.global.f32 [%rd1+4], %f2;

    /* --- STEP 6: Terminate thread execution --- */
    ret;
}
