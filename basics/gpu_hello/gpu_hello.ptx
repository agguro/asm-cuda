.version 6.5
.target sm_61
.address_size 64

.file 1 "gpu_hello.ptx"

.visible .entry gpu_hello(
    .param .u64 result_ptr
) {
    /* --- Register Declarations --- */
    .reg .u64     %base;
    .reg .u32     %t;
    .reg .u64     %off;
    .reg .u64     %dest;

    /* --- STEP 1: Load base address from parameter buffer --- *
     * result_ptr is the address in the parameter space.        *
     * We load the actual 64-bit GPU global memory address from it. */
    ld.param.u64  %base, [result_ptr];

    /* --- STEP 2: Capture local thread index --- *
     * Read the thread identifier along the X dimension (%tid.x). */
    mov.u32       %t, %tid.x;

    /* --- STEP 3: Calculate byte offset --- *
     * Compute offset = thread_id * sizeof(uint32) -> tid * 4 bytes. */
    mul.wide.u32  %off, %t, 4;

    /* --- STEP 4: Compute destination address --- *
     * Add the calculated byte offset to the base memory pointer. */
    add.u64       %dest, %base, %off;

    /* --- STEP 5: Store thread ID to global memory --- *
     * Write the 32-bit thread ID directly into the global VRAM buffer. */
    st.global.u32 [%dest], %t;

    /* --- STEP 6: Terminate thread execution --- */
    ret;
}
