.version 7.8
.target sm_61
.address_size 64

.file 1 "gpu_pointertest.ptx"

.visible .entry pointertest(
    .param .u64 a,
    .param .u64 b,
    .param .u64 c,
    .param .u64 n
) {
    /* --- Register Declarations --- */
    .reg .b64     %ra;
    .reg .b64     %rb;
    .reg .b64     %rc;
    .reg .b64     %rd_out;

    /* --- STEP 1: Load pointer 'a' from parameter space --- *
     * Fetch the 64-bit memory address passed as parameter 'a'. */
    ld.param.u64  %ra, [a];

    /* --- STEP 2: Load pointer 'b' from parameter space --- *
     * Fetch the 64-bit memory address passed as parameter 'b'. */
    ld.param.u64  %rb, [b];

    /* --- STEP 3: Load pointer 'c' from parameter space --- *
     * Fetch the 64-bit memory address passed as parameter 'c'. */
    ld.param.u64  %rc, [c];

    /* --- STEP 4: Store pointers sequentially into global VRAM --- *
     * Use pointer 'c' as the destination to store all three addresses *
     * as an 8-byte (64-bit) value sequence.                          */
    st.global.u64 [%rc],    %ra;
    st.global.u64 [%rc+8],  %rb;
    st.global.u64 [%rc+16], %rc;

    /* --- STEP 5: Terminate thread execution --- */
    ret;
}
