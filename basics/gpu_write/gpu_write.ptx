.version 6.5
.target sm_61
.address_size 64

.file 1 "gpu_thread_write.ptx"

.visible .entry gpu_thread_write(
    .param .u64 a,
    .param .u64 b,
    .param .u64 c,
    .param .u32 n
) {
    /* --- Register Declarations --- */
    .reg .u32     %r<4>;
    .reg .u64     %rd<4>;
    .reg .f32     %f1;

    /* --- STEP 1: Compute Global Thread Index --- *
     * Formula: i = (blockIdx.x * blockDim.x) + threadIdx.x *
     * Using mad.lo.u32 for efficient multiply-add calculation. */
    mov.u32       %r0, %ctaid.x;
    mov.u32       %r1, %ntid.x;
    mov.u32       %r2, %tid.x;
    mad.lo.u32    %r3, %r0, %r1, %r2;

    /* --- STEP 2: Load destination pointer 'c' --- *
     * Fetch the 64-bit base memory address from the parameter space. */
    ld.param.u64  %rd1, [c];

    /* --- STEP 3: Calculate memory byte offset --- *
     * Compute offset = index * sizeof(float) -> index * 4 bytes. *
     * Add offset to the base pointer to get target memory address. */
    mul.wide.u32  %rd2, %r3, 4;
    add.u64       %rd3, %rd1, %rd2;

    /* --- STEP 4: Convert integer index to float --- *
     * Cast the 32-bit integer thread index to a single-precision float (e.g., 5 -> 5.0). */
    cvt.rn.f32.u32 %f1, %r3;

    /* --- STEP 5: Write float value to global VRAM --- *
     * Store the converted thread index directly into global memory. */
    st.global.f32 [%rd3], %f1;

    /* --- STEP 6: Terminate thread execution --- */
    ret;
}
